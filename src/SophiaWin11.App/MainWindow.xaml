<ui:FluentWindow x:Class="SophiaWin11.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Sophia Script for Win11"
                 Width="1280"
                 Height="800"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource BrushBackgroundDeep}"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <ui:TitleBar Title="Sophia Script for Win11" VerticalAlignment="Top" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="24"
                       Foreground="{DynamicResource BrushAccentGold}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding IsElevated}"
                       FontSize="14"
                       Foreground="{DynamicResource BrushAccentPeacock}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
            <ui:Button Content="Apply Theme"
                       Command="{Binding ApplyThemeCommand}"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>

</ui:FluentWindow>
