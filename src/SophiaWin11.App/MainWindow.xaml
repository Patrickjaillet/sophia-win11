<ui:FluentWindow x:Class="SophiaWin11.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Sophia Script for Win11"
                 Width="1280"
                 Height="800"
                 MinWidth="900"
                 MinHeight="600"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource BrushBackgroundDeep}"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="Sophia Script for Win11" />

        <ui:NavigationView x:Name="RootNavigation"
                            Grid.Row="1"
                            MenuItemsSource="{Binding NavigationItems}"
                            IsPaneOpen="True"
                            OpenPaneLength="260"
                            TitleBar="{Binding ElementName=AppTitleBar}">
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="RootSnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <Border Grid.Row="1"
                Background="{DynamicResource BrushBackgroundDeep}"
                Opacity="0.92"
                Visibility="{Binding IsInitializing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" />
                <TextBlock Text="{Binding StatusText}"
                           Margin="0,12,0,0"
                           Foreground="{DynamicResource BrushAccentGold}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>

</ui:FluentWindow>
