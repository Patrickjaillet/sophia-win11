<ui:FluentWindow x:Class="SophiaWin11.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:uicontrols="clr-namespace:SophiaWin11.UI.Controls;assembly=SophiaWin11.UI"
                 Title="Sophia Script for Win11"
                 Width="1280"
                 Height="800"
                 MinWidth="900"
                 MinHeight="600"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource BrushBackgroundDeep}"
                 FontFamily="{DynamicResource FontFamilyBody}"
                 FontSize="{DynamicResource FontSizeBody}"
                 Foreground="{DynamicResource BrushTextPrimary}"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource BrushBackgroundCharcoal}"
                Opacity="0.22"
                IsHitTestVisible="False" />
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource BrushArtDecoMotif}"
                IsHitTestVisible="False" />
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource BrushArtDecoNoise}"
                IsHitTestVisible="False" />

        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="Sophia Script for Win11"
                     FontFamily="{DynamicResource FontFamilyDisplayAccent}" />

        <ui:NavigationView x:Name="RootNavigation"
                            Grid.Row="1"
                            MenuItemsSource="{Binding NavigationItems}"
                            IsPaneOpen="True"
                            OpenPaneLength="260"
                            FontFamily="{DynamicResource FontFamilyBody}"
                            TitleBar="{Binding ElementName=AppTitleBar}">
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="RootSnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <Border Grid.Row="1"
                Background="{DynamicResource BrushBackgroundDeep}"
                Opacity="0.92"
                Visibility="{Binding IsInitializing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <uicontrols:LottieAnimationPresenter Width="96"
                                                      Height="96"
                                                      Source="pack://application:,,,/SophiaWin11.UI;component/Assets/Animations/splash-loop.json"
                                                      IsPlaying="{Binding IsInitializing}" />
                <TextBlock Text="{Binding StatusText}"
                           FontFamily="{DynamicResource FontFamilyBody}"
                           FontSize="{DynamicResource FontSizeBody}"
                           Margin="0,12,0,0"
                           Foreground="{DynamicResource BrushAccentGold}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>

</ui:FluentWindow>
