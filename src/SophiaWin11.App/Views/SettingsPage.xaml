<UserControl x:Class="SophiaWin11.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SophiaWin11.App.ViewModels"
             xmlns:loc="clr-namespace:SophiaWin11.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock Text="{loc:Translate Key=Settings_Header}"
                       FontFamily="{DynamicResource FontFamilyDisplay}"
                       FontSize="{DynamicResource FontSizeDisplayLarge}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushAccentGold}"
                       Margin="0,0,0,16" />

            <ui:CardControl Icon="{ui:SymbolIcon LocalLanguage24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Key=Settings_LanguageLabel}"
                                   FontFamily="{DynamicResource FontFamilyBody}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Translate Key=Settings_LanguageDescription}"
                                   FontFamily="{DynamicResource FontFamilyBody}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextWrapping="Wrap"
                                   MaxWidth="480" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="NativeName"
                          MinWidth="180" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
