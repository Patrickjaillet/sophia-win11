<UserControl x:Class="SophiaWin11.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             xmlns:vm="clr-namespace:SophiaWin11.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock Text="Dashboard"
                       FontFamily="{DynamicResource FontFamilyDisplay}"
                       FontSize="{DynamicResource FontSizeDisplayLarge}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushAccentGold}"
                       Margin="0,0,0,16" />

            <UniformGrid Columns="2" Rows="1" Margin="0,0,0,16">
                <ui:CardControl Margin="0,0,8,0">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="AppsListDetail24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Total tweaks"
                                       FontFamily="{DynamicResource FontFamilyBody}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       FontSize="{DynamicResource FontSizeCaption}" />
                            <TextBlock Text="{Binding TotalTweaksCount}"
                                       FontFamily="{DynamicResource FontFamilyDisplay}"
                                       FontSize="{DynamicResource FontSizeDisplayMedium}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <ui:CardControl Margin="8,0,0,0">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Currently applied"
                                       FontFamily="{DynamicResource FontFamilyBody}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       FontSize="{DynamicResource FontSizeCaption}" />
                            <TextBlock Text="{Binding AppliedTweaksCount}"
                                       FontFamily="{DynamicResource FontFamilyDisplay}"
                                       FontSize="{DynamicResource FontSizeDisplayMedium}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ProgressRing IsIndeterminate="True"
                                      Width="18"
                                      Height="18"
                                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </ui:CardControl>
            </UniformGrid>

            <ui:CardExpander Icon="{ui:SymbolIcon DataHistogram24}"
                              Margin="0,0,0,16">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Text="Last session"
                                   FontFamily="{DynamicResource FontFamilyBody}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastSessionSummary}"
                                   FontFamily="{DynamicResource FontFamilyBody}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   FontSize="{DynamicResource FontSizeCaption}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <TextBlock TextWrapping="Wrap"
                           FontFamily="{DynamicResource FontFamilyBody}"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           Margin="0,8,0,8"
                           Text="Session history is not persisted across app restarts yet. Applying tweaks from this dashboard or a category page updates the counts above immediately." />
            </ui:CardExpander>

            <ui:CardControl Icon="{ui:SymbolIcon FolderOpen24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Profiles"
                                   FontFamily="{DynamicResource FontFamilyBody}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Save currently applied tweaks to a .sophiaprofile file, or apply one back."
                                   FontFamily="{DynamicResource FontFamilyBody}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Load profile" Command="{Binding LoadProfileCommand}" />
                    <ui:Button Content="Save profile" Margin="8,0,0,0" Command="{Binding SaveProfileCommand}" />
                    <ui:Button Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Appearance="Secondary" />
                </StackPanel>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
