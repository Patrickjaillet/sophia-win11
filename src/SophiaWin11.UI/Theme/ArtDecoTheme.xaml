<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="pack://application:,,,/SophiaWin11.UI;component/Theme/DesignTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{DynamicResource ColorBackgroundDeep}" />
    <SolidColorBrush x:Key="WindowBackground" Color="{DynamicResource ColorBackgroundDeep}" />
    <SolidColorBrush x:Key="WindowForeground" Color="{DynamicResource ColorTextPrimary}" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{DynamicResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{DynamicResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextFillColorDisabled" Color="{DynamicResource ColorTextDisabled}" />

    <Color x:Key="AccentFillColorDefault">#D4AF37</Color>
    <Color x:Key="AccentFillColorSecondary">#F4E5A1</Color>
    <Color x:Key="AccentFillColorTertiary">#B8860B</Color>
    <Color x:Key="SystemAccentColorPrimary">#D4AF37</Color>
    <Color x:Key="SystemAccentColorSecondary">#F4E5A1</Color>
    <Color x:Key="SystemAccentColorTertiary">#B8860B</Color>

    <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource ColorBackgroundCharcoal}" />
    <SolidColorBrush x:Key="CardBackgroundPointerOver" Color="#1B1B29" />
    <SolidColorBrush x:Key="CardBackgroundPressed" Color="#101019" />
    <SolidColorBrush x:Key="CardBackgroundDisabled" Color="#121219" />
    <SolidColorBrush x:Key="CardForeground" Color="{DynamicResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="CardForegroundPointerOver" Color="{DynamicResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="CardForegroundPressed" Color="{DynamicResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="CardForegroundDisabled" Color="{DynamicResource ColorTextDisabled}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource ColorAccentGold}" Opacity="0.35" />
    <SolidColorBrush x:Key="CardFooterBackground" Color="{DynamicResource ColorBackgroundCharcoal}" />

    <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource ColorBackgroundCharcoal}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E1E2E" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0E0E14" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#121219" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource ColorAccentGoldLight}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource ColorAccentGold}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{DynamicResource ColorTextDisabled}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource ColorAccentGold}" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#2A2A38" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{DynamicResource ColorAccentGold}" Opacity="0.45" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="{DynamicResource ColorAccentGoldLight}" Opacity="0.75" />

    <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource ColorAccentGold}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource ColorAccentGoldLight}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource ColorAccentGoldDark}" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="{DynamicResource ColorBackgroundDeep}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{DynamicResource ColorBackgroundDeep}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{DynamicResource ColorBackgroundDeep}" />

    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource ColorAccentGold}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource ColorAccentGoldLight}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource ColorAccentGoldDark}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{DynamicResource ColorBackgroundCharcoal}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#1E1E2E" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#0E0E14" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#121219" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#4A4326" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{DynamicResource ColorAccentGold}" Opacity="0.55" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{DynamicResource ColorAccentGold}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{DynamicResource ColorAccentGoldLight}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#2A2A38" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource ColorBackgroundDeep}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource ColorBackgroundDeep}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{DynamicResource ColorBackgroundDeep}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#2A2A38" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{DynamicResource ColorAccentGold}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{DynamicResource ColorAccentGoldLight}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="{DynamicResource ColorAccentGoldDark}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#5A5648" />
    <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{DynamicResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="ToggleSwitchContentForegroundDisabled" Color="{DynamicResource ColorTextDisabled}" />

    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{DynamicResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{DynamicResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{DynamicResource ColorAccentGold}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundLeftFluent" Color="{DynamicResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOverLeftFluent" Color="{DynamicResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{DynamicResource ColorAccentGold}" />
    <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="{DynamicResource ColorAccentGold}" Opacity="0.25" />
    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{DynamicResource ColorBackgroundCharcoal}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{DynamicResource ColorBackgroundCharcoal}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedLeftFluent" Color="{DynamicResource ColorBackgroundCharcoal}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#0E0E14" />
    <SolidColorBrush x:Key="NavigationViewItemBorderBrush" Color="Transparent" />

    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{DynamicResource ColorAccentGold}" Opacity="0.3" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{DynamicResource ColorAccentGold}" Opacity="0.2" />

    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>

    <Style x:Key="ArtDecoCardControlStyle"
           BasedOn="{StaticResource DefaultUiCardControlStyle}"
           TargetType="{x:Type controls:CardControl}">
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDecorated}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18"
                                   Direction="270"
                                   ShadowDepth="2"
                                   Opacity="0.35"
                                   Color="{DynamicResource ColorAccentGold}" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ArtDecoCardControlStyle}" TargetType="{x:Type controls:CardControl}" />

    <Style x:Key="ArtDecoButtonStyle"
           BasedOn="{StaticResource DefaultUiButtonStyle}"
           TargetType="{x:Type controls:Button}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessThin}" />
    </Style>
    <Style BasedOn="{StaticResource ArtDecoButtonStyle}" TargetType="{x:Type controls:Button}" />

    <Style x:Key="ArtDecoToggleSwitchStyle"
           BasedOn="{StaticResource DefaultUiToggleSwitchStyle}"
           TargetType="{x:Type controls:ToggleSwitch}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10"
                                   ShadowDepth="0"
                                   Opacity="0.5"
                                   Color="{DynamicResource ColorAccentGold}" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ArtDecoToggleSwitchStyle}" TargetType="{x:Type controls:ToggleSwitch}" />

    <Style x:Key="ArtDecoCardExpanderStyle"
           BasedOn="{StaticResource DefaultUiCardExpanderStyle}"
           TargetType="{x:Type controls:CardExpander}">
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessThin}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
    </Style>
    <Style BasedOn="{StaticResource ArtDecoCardExpanderStyle}" TargetType="{x:Type controls:CardExpander}" />

</ResourceDictionary>
